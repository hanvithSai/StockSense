# MongoDB connection. A replica set is required (stock moves use transactions):
# MongoDB Atlas, or the local one from `docker compose up -d`.
MONGODB_URI=mongodb://localhost:27017/stocksense?replicaSet=rs0

# Session signing key, at least 32 random characters: `openssl rand -base64 48`
AUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Optional SMTP for password reset codes. Without it the code is printed in the server log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StockSense <no-reply@example.com>"

# Demo helpers: show the reset code on screen when SMTP is not configured, and list demo accounts on the login page.
OTP_DEV_ECHO=false
NEXT_PUBLIC_DEMO_MODE=false
